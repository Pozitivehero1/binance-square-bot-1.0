# ============================================================
# Binance Square Bot — Attention Edition
# Копируйте файл в .env. Безопасный режим включён по умолчанию.
# Сторонний cron должен запускать: python run_bot.py
# ============================================================

# --- Публикация ---
SQUARE_API=
BINANCE_SQUARE_OPENAPI_KEY=
PUBLISH_TIMEOUT=90
# Необязательно: абсолютный путь к установленному square-post skill.
SQUARE_SKILL_DIR=

# --- Генерация текста ---
# ai_first использует Mistral только как редактора короткой фразы без цифр.
# Цены, уровни, направление, цели и отмену по-прежнему формирует Python.
# Если Mistral недоступен или вернул плохой JSON, deterministic включается автоматически.
CONTENT_MODE=ai_first
MISTRAL_API=
MISTRAL_MODEL=mistral-small-latest
AI_VARIANTS=4
AI_TEMPERATURE=0.58
AI_TIMEOUT=50
AUTHOR_VOICE=direct
# 0 = только feed-first форматы; 1 = иногда разрешать сухие risk/data/indicator memo.
ALLOW_TECHNICAL_FORMATS=0

# --- Качество и антидубликат ---
POST_VARIANTS=16
POST_MIN_CHARS=160
POST_MAX_CHARS=620
MIN_POST_QUALITY=82
MIN_FEED_APPEAL=74
MAX_POST_SIMILARITY=0.52

# --- Частота публикаций ---
# По умолчанию именно cron задаёт частоту. При запуске cron каждые 20 минут
# бот имеет право публиковать каждый запуск. Это также игнорирует старые значения 120/6.
ENABLE_PACING_LIMITS=0
MIN_GLOBAL_INTERVAL_MIN=20
MAX_POSTS_PER_DAY=72
# Дополнительный distribution gate: слабый по рынку запуск можно пропустить.
ENABLE_REACH_GATE=1
MIN_REACH_SCORE=64
# Не повторять одну и ту же монету слишком быстро, но другие тикеры публиковать можно.
COOLDOWN_MIN=180
FORCE_PUBLISH=0

# Необязательно: разрешённые окна локального времени, например:
# PUBLISH_WINDOWS=07:00-10:00,12:00-15:00,18:00-22:30
PUBLISH_WINDOWS=
BOT_TIMEZONE=UTC

# --- Постоянное состояние и диагностика ---
# Все относительные имена ниже сохраняются внутри STATE_DIR независимо от cwd cron.
STATE_DIR=state
POST_MEMORY_FILE=post_memory.json
PUBLISHED_HISTORY_FILE=published_history.json
PUBLICATION_STATE_FILE=publication_state.json
BOT_STATUS_FILE=status.json
RUN_LOCK_FILE=bot.lock
LOCK_STALE_MIN=45
LOG_FILE=logs/bot.log
LOG_MAX_BYTES=3000000
LOG_BACKUPS=5

# --- Медиа ---
PUBLISH_IMAGES=1
PUBLISH_MEDIA_MODE=adaptive
CARD_WATERMARK=PozitiveHero
CHART_WATERMARK=PozitiveHero

# --- Universe и загрузка данных ---
TOP_SYMBOLS=80
SHORTLIST_SIZE=18
FINAL_CANDIDATES=10
DATA_WORKERS=6
KLINE_LIMIT=260
MIN_QUOTE_VOLUME=8000000

# --- Строгий фильтр сигналов ---
MIN_SIGNAL_SCORE=54
MIN_ADX=17.5
MIN_ATR_PCT=0.25
MAX_ATR_PCT=7.0
MIN_RR=1.25
MIN_MTF_ALIGN=0.34
MIN_VOLUME_REL=0.55
MAX_FUNDING_ABS=0.001
STRICT_BTC_FILTER=1

# Резерв для near-threshold сетапов. Attention-score влияет на выбор лучшей темы, но не режет частоту.
ENABLE_BALANCED_FALLBACK=1
BALANCED_MIN_SIGNAL_SCORE=50
BALANCED_MIN_ADX=16.5
BALANCED_MIN_ATR_PCT=0.18
BALANCED_MAX_ATR_PCT=8.5
BALANCED_MIN_RR=1.05
BALANCED_MIN_MTF_ALIGN=0.33
BALANCED_MIN_VOLUME_REL=0.30

ENABLE_BYBIT_FALLBACK=0

# --- Безопасность запуска ---
DRY_RUN=1
LOG_LEVEL=INFO

# Write-to-Earn optimization
# Market gate: prefer coins where there is both live attention and real trading activity.
MIN_W2E_MARKET_SCORE=56
W2E_SOFT_FLOOR=40
HOT_W2E_FLOOR=34
HOT_TECH_MIN=65
HOT_ATTENTION_MIN=82
HOT_VOLUME_SPIKE_MIN=3
HOT_MOVE_15M_MIN=1.2
# Post gate: cashtag discoverability + actionable decision context + anti-spam trust.
MIN_CONVERSION_INTENT=70
