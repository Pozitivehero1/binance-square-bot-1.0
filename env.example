# Required for real publication
SQUARE_API=
BINANCE_SQUARE_OPENAPI_KEY=

# Optional AI polishing. Disabled by default to prevent hallucinated facts.
MISTRAL_API=
ENABLE_AI_POLISH=0
MISTRAL_MODEL=mistral-small-latest

# Candidate selection
TOP_SYMBOLS=80
SHORTLIST_SIZE=18
FINAL_CANDIDATES=10
DATA_WORKERS=6
KLINE_LIMIT=260
COOLDOWN_MIN=180
MIN_QUOTE_VOLUME=8000000

# Strict signal gates (first pass)
MIN_SIGNAL_SCORE=54
MIN_ADX=18
MIN_ATR_PCT=0.25
MAX_ATR_PCT=7.0
MIN_RR=1.25
MIN_MTF_ALIGN=0.34
MIN_VOLUME_REL=0.65

# Balanced signal gates (used only if strict pass finds nothing)
ENABLE_BALANCED_FALLBACK=1
BALANCED_MIN_SIGNAL_SCORE=50
BALANCED_MIN_ADX=16.5
BALANCED_MIN_ATR_PCT=0.18
BALANCED_MAX_ATR_PCT=8.5
BALANCED_MIN_RR=1.05
BALANCED_MIN_MTF_ALIGN=0.33
BALANCED_MIN_VOLUME_REL=0.30

# Funding/BTC safety
MAX_FUNDING_ABS=0.001
STRICT_BTC_FILTER=1

# Bybit blocks many US-hosted runners with HTTP 403; Binance remains primary.
ENABLE_BYBIT_FALLBACK=0

# Post quality
POST_VARIANTS=8
MIN_POST_QUALITY=72
POST_MAX_CHARS=1600
PUBLISH_IMAGES=1

# Safe local test mode: generate content and images, but do not publish
DRY_RUN=0
LOG_LEVEL=INFO

# Post diversity
MAX_POST_SIMILARITY=0.56
