# Required for real publication
SQUARE_API=
BINANCE_SQUARE_OPENAPI_KEY=

# Optional AI polishing. Disabled by default to prevent hallucinated facts.
MISTRAL_API=
ENABLE_AI_POLISH=0
MISTRAL_MODEL=mistral-small-latest

# Candidate selection
TOP_SYMBOLS=80
SHORTLIST_SIZE=18
FINAL_CANDIDATES=10
DATA_WORKERS=6
KLINE_LIMIT=260
COOLDOWN_MIN=180
MIN_QUOTE_VOLUME=8000000

# Signal gates
MIN_SIGNAL_SCORE=54
MIN_ADX=18
MIN_ATR_PCT=0.25
MAX_ATR_PCT=7.0
MIN_RR=1.5
MIN_MTF_ALIGN=0.5
MIN_VOLUME_REL=0.75
MAX_FUNDING_ABS=0.001
STRICT_BTC_FILTER=1

# Post quality
POST_VARIANTS=5
MIN_POST_QUALITY=72
POST_MAX_CHARS=1600
PUBLISH_IMAGES=1

# Safe local test mode: generate content and images, but do not publish
DRY_RUN=0
LOG_LEVEL=INFO
