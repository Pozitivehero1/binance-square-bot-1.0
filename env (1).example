# Required for real publication
SQUARE_API=
BINANCE_SQUARE_OPENAPI_KEY=

# AI-first copy generation. MISTRAL_API_KEY is also accepted.
MISTRAL_API=
MISTRAL_MODEL=mistral-small-latest
CONTENT_MODE=ai_first
AI_VARIANTS=4
AI_TEMPERATURE=0.55
AI_MIN_VALID=2
AI_TIMEOUT=50

# Legacy AI polishing remains disabled. The new AI-first engine is fact-locked.
ENABLE_AI_POLISH=0

# Candidate selection
TOP_SYMBOLS=80
SHORTLIST_SIZE=18
FINAL_CANDIDATES=10
DATA_WORKERS=6
KLINE_LIMIT=260
COOLDOWN_MIN=180
MIN_QUOTE_VOLUME=8000000

# Strict signal gates
MIN_SIGNAL_SCORE=54
MIN_ADX=17.5
MIN_ATR_PCT=0.25
MAX_ATR_PCT=7.0
MIN_RR=1.25
MIN_MTF_ALIGN=0.34
MIN_VOLUME_REL=0.55
MAX_FUNDING_ABS=0.001
STRICT_BTC_FILTER=1

# Disabled by default: do not publish near-threshold signals just to fill the feed.
ENABLE_BALANCED_FALLBACK=1
BALANCED_MIN_SIGNAL_SCORE=50
BALANCED_MIN_ADX=16.5
BALANCED_MIN_ATR_PCT=0.18
BALANCED_MAX_ATR_PCT=8.5
BALANCED_MIN_RR=1.05
BALANCED_MIN_MTF_ALIGN=0.33
BALANCED_MIN_VOLUME_REL=0.30

# Bybit can block US-hosted runners. Binance remains primary.
ENABLE_BYBIT_FALLBACK=0

# Short-form content contract
POST_VARIANTS=8
POST_MIN_CHARS=260
POST_MAX_CHARS=900
MIN_POST_QUALITY=78
MAX_POST_SIMILARITY=0.45

# Media: chart, card, both, or none
PUBLISH_IMAGES=1
PUBLISH_MEDIA_MODE=chart
CHART_WATERMARK=PozitiveHero

# Safe local mode: analyze and print, but do not publish
DRY_RUN=1
LOG_LEVEL=INFO
